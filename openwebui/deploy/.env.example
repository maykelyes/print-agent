# Copy to .env on the server (never commit .env).

# Public hostname. Caddy gets an HTTPS certificate for it automatically.
# Until DNS is set up, <ip-with-dashes>.sslip.io works, e.g. 161-35-156-175.sslip.io
DOMAIN=print.example.com

# Keep the same value as the instance the database came from (D:\openwebui\.webui_secret_key)
WEBUI_SECRET_KEY=
